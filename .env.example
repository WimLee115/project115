# Project115 — omgevingsvariabelen
#
# Kopieer dit bestand naar .env en vul de waarden in.
# Het .env-bestand staat in .gitignore en mag nooit gedeeld worden.

# ---------------------------------------------------------------------------
# APP_SECRET (verplicht)
#
# Wordt gebruikt om het TOTP-secret te versleutelen en om IP-adressen te
# peperen voordat ze worden gehasht. Minimaal 32 tekens.
#
# Genereer een nieuwe met:
#   openssl rand -base64 48
#
# Let op: als je dit secret wijzigt, is bestaande tweestapsverificatie niet
# meer te ontsleutelen en moet je die opnieuw instellen.
# ---------------------------------------------------------------------------
APP_SECRET=vul-hier-de-uitvoer-van-openssl-rand-base64-48-in

# ---------------------------------------------------------------------------
# DATABASE_PATH (optioneel)
#
# Pad naar het SQLite-bestand. Binnen Docker wordt dit overschreven naar
# /data/project115.db (een named volume).
# ---------------------------------------------------------------------------
DATABASE_PATH=./data/project115.db

# ---------------------------------------------------------------------------
# SITE_ADDRESS (alleen voor Docker)
#
# Het adres waarop je de hub benadert. Bepaalt waarvoor Caddy een certificaat
# maakt. Voorbeelden:
#   https://localhost
#   https://project115.local
#   https://192.168.1.50
# ---------------------------------------------------------------------------
SITE_ADDRESS=https://localhost

# ---------------------------------------------------------------------------
# SKIP_SEED (optioneel, alleen voor Docker)
#
# Zet op 1 om het laden van de vragenbank bij het opstarten over te slaan.
# Handig als je zelf vragen hebt aangepast en die niet wilt laten overschrijven.
# ---------------------------------------------------------------------------
SKIP_SEED=0
