{
  "name": "project115",
  "version": "1.1.2",
  "private": true,
  "description": "Project115 — tweetalige (NL/EN) studiehub voor ITIL Foundation (Version 5) en EXIN Information Security Foundation based on ISO/IEC 27001",
  "author": "B. van Rooij",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "validate": "tsx scripts/validate-content.ts && tsx scripts/check-afleiders.ts && tsx scripts/check-overname.ts",
    "setup": "npm run db:migrate && npm run db:seed",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test --import tsx test/*.test.ts",
    "test:integration": "node --conditions=react-server --test --import tsx test/*.test.mts",
    "test:e2e": "tsx scripts/e2e.ts",
    "docs": "weasyprint docs/handleiding.html 'Project115 - Handleiding.pdf'",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "package:project": "tsx scripts/package-project.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.0.2",
    "better-sqlite3": "13.0.2",
    "drizzle-orm": "0.45.2",
    "next": "16.2.12",
    "otpauth": "9.5.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "ts-fsrs": "5.4.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "^26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "drizzle-kit": "0.31.10",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "overrides": {
    "postcss": "^8.5.24",
    "sharp": "^0.35.0",
    "esbuild": "^0.25.12"
  }
}
